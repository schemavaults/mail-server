{
  "name": "@schemavaults/mail-server",
  "version": "0.0.35",
  "description": "Manages the SchemaVaults mailing list, sending to the list, mail templates, and sending transactional emails.",
  "type": "module",
  "private": true,
  "dependencies": {
    "react-email": "4.0.17",
    "resend": "4.7.0",
    "@react-email/components": "0.1.1",
    "@react-email/render": "1.1.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "next": "16.1.6",
    "@schemavaults/theme": "0.25.5",
    "@schemavaults/ui": "0.14.5",
    "@schemavaults/auth-react-provider": "0.10.17",
    "@schemavaults/auth-server-sdk": "0.21.18",
    "@schemavaults/app-definitions": "0.6.21",
    "@schemavaults/dbh": "0.8.7",
    "server-only": "0.0.1",
    "zod": "3.25.8",
    "swr": "2.4.1",
    "lucide-react": "0.575.0"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/bun": "1.3.6",
    "typescript": "5.9.3",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "autoprefixer": "10.4.21"
  },
  "scripts": {
    "dev:mail": "email dev --dir ./src/email-templates --port 5347",
    "dev:app": "bun run auth-codegen && PORT=5346 SCHEMAVAULTS_APP_ENVIRONMENT=development NEXT_PUBLIC_SCHEMAVAULTS_APP_ENVIRONMENT=development next dev",
    "build": "bun run auth-codegen && SCHEMAVAULTS_APP_ENVIRONMENT=production NEXT_PUBLIC_SCHEMAVAULTS_APP_ENVIRONMENT=production next build",
    "auth-codegen": "bunx @schemavaults/auth-server-sdk codegen"
  },
  "packageManager": "bun@1.3.6"
}
