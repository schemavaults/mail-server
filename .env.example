SCHEMAVAULTS_GITHUB_PACKAGE_REGISTRY_USER="jalexw"
SCHEMAVAULTS_GITHUB_PACKAGE_REGISTRY_TOKEN="blahblahblah"

SCHEMAVAULTS_APP_ENVIRONMENT="production"
NEXT_PUBLIC_SCHEMAVAULTS_APP_ENVIRONMENT="production"
SCHEMAVAULTS_API_SERVER_ID="schemavaults-mail"
# Public base URL of this mail server (used for links embedded in emails)
HOST="https://mail.schemavaults.com"

# --- White-label branding ---
# Brand/product name used in UI chrome, page metadata, and email copy
BRAND_NAME="SchemaVaults"
# URL of the brand's main web app (Nav wordmark link, footer, email CTAs)
BRAND_URL="https://schemavaults.com"
# Support contact shown in email footers
BRAND_SUPPORT_EMAIL="support@schemavaults.com"
# Default sender for outbound mail (From: "MAIL_FROM_NAME <MAIL_FROM_ADDRESS>");
# MAIL_FROM_NAME falls back to BRAND_NAME when unset
MAIL_FROM_ADDRESS="noreply@schemavaults.com"
MAIL_FROM_NAME=""
# Primary brand color (CSS color). Used for email buttons/links and, together
# with BRAND_SECONDARY_COLOR, the <Wordmark /> gradient (from -> to). When the
# pair is unset the wordmark uses the theme's default brand-color tokens.
BRAND_PRIMARY_COLOR=""
BRAND_SECONDARY_COLOR=""
# Light accent used as the first stop of email hero-header gradients
BRAND_ACCENT_COLOR=""
# Set to "false" to hide the public mailing list directory on the homepage
# (it renders a minimal branded landing page instead), for orgs that use this
# app solely as an email template/sender rather than a mailing list
# management tool. Defaults to "true".
HOMEPAGE_SHOW_MAILING_LISTS="true"
# Optional footer links — each is hidden in the UI when unset
BRAND_GITHUB_URL=""
BRAND_TWITTER_URL=""
BRAND_LINKEDIN_URL=""
BRAND_PRIVACY_POLICY_URL=""
BRAND_TERMS_URL=""
SCHEMAVAULTS_AUTH_SERVER_URL="https://auth.schemavaults.com"
SCHEMAVAULTS_AUTH_SERVER_APP_ID="schemavaults-auth"
SCHEMAVAULTS_AUTH_JWKS_ACCESS_PRIVATE_KEY=""

POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""
POSTGRES_USER=""
POSTGRES_HOST=""
POSTGRES_PASSWORD=""
POSTGRES_DATABASE=""

RESEND_API_KEY=""

ADMIN_MAILING_LIST_NAME="SchemaVaults Admins"
ADMIN_MAILING_LIST_DESCRIPTION="Internal SchemaVaults administrator notifications."
